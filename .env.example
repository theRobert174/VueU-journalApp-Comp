# Copia este archivo a .env.local y reemplaza los valores por los de tu propio
# proyecto de Firebase (Authentication + Realtime Database) y tu cuenta de Cloudinary.
# .env.local nunca se sube a git (ver .gitignore).

VUE_APP_FIREBASE_API_KEY=
VUE_APP_FIREBASE_DB_URL=

VUE_APP_CLOUDINARY_CLOUD_NAME=
VUE_APP_CLOUDINARY_UPLOAD_PRESET=
